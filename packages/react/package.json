{
  "name": "@opace/react-preferred-source",
  "version": "0.1.0",
  "description": "Google Preferred Sources button for React and Next.js: client component + hook, SSR-safe, deeplink fallback, honest ps-click analytics events.",
  "license": "MIT",
  "author": "Opace Ltd (https://www.opace.agency)",
  "homepage": "https://opace.agency/tools/seo/google-preferred-source-button-generator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpaceDigitalAgency/add-as-preferred-source-button-for-google.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/OpaceDigitalAgency/add-as-preferred-source-button-for-google/issues",
  "keywords": [
    "google",
    "preferred-sources",
    "preferred-source",
    "google-preferred-sources",
    "seo",
    "publisher",
    "top-stories",
    "ai-overviews",
    "react",
    "nextjs",
    "react-component",
    "hooks"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opace/preferred-source-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
