{
  "name": "@opace/vue-preferred-source",
  "version": "1.0.0",
  "description": "Add as Preferred Source Button & Popup for Google (SEO & AI Overviews) for Vue and Nuxt: component, composable, plugin, fallback and ps-click instrumentation.",
  "license": "MIT",
  "author": "Opace Ltd (https://www.opace.agency)",
  "homepage": "https://opace.agency/add-as-preferred-source-button-for-google/button-generator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpaceDigitalAgency/add-as-preferred-source-button-for-google.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/OpaceDigitalAgency/add-as-preferred-source-button-for-google/issues",
  "keywords": [
    "google",
    "preferred-sources",
    "preferred-source",
    "google-preferred-sources",
    "seo",
    "publisher",
    "top-stories",
    "ai-overviews",
    "vue",
    "vue3",
    "nuxt",
    "vue-component"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opace/preferred-source-core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "vite": "^5.4.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
